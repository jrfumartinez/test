{
    "version": 8,
    "configurePresets": [
        {
            "name": "GCC 15.3.1 x86_64-redhat-linux",
            "displayName": "GCC 15.3.1 x86_64-redhat-linux",
            "description": "Uso de compiladores: C = /usr/bin/gcc-15",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "/usr/bin/gcc-15",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "GCC 16.1.1 x86_64-redhat-linux",
            "displayName": "GCC 16.1.1 x86_64-redhat-linux",
            "description": "Uso de compiladores: C = /usr/bin/gcc, CXX = /usr/bin/g++",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "/usr/bin/gcc",
                "CMAKE_CXX_COMPILER": "/usr/bin/g++",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ]
}